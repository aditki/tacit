# ─────────────────────────────────────────────────────────────────────────────
# Tacit Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy to tacit.yaml (or set TACIT_CONFIG=/path/to/config.yaml)
#
# Loading priority (last wins):
#   1. Defaults (in code)
#   2. This YAML file
#   3. .env file
#   4. Environment variables
#
# SECRETS (api keys, tokens) should go in .env or env vars, NOT here.
# This file is for non-sensitive, environment-specific configuration.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM ──────────────────────────────────────────────────────────────────────
llm:
  provider: openai            # anthropic | openai | azure | bedrock | ollama
  model: gpt-4o               # model name (provider-specific)
  api_base: ""                 # custom endpoint (Azure, Ollama, vLLM, etc.)
  # api_key: use LLM_API_KEY env var
  bedrock_region: us-east-1    # only used when provider is bedrock
  bedrock_model_id: ""         # optional exact model/inference-profile ID; empty uses model
  bedrock_role_arn: ""         # optional IAM role to assume
  # Put LLM_AWS_ACCESS_KEY_ID, LLM_AWS_SECRET_ACCESS_KEY, and the optional
  # LLM_AWS_SESSION_TOKEN in the environment, never in this YAML file.

# ── Grafana ──────────────────────────────────────────────────────────────────
grafana:
  url: http://localhost:3000
  # public_url: browser-facing base for generated dashboard links. Set when
  # `url` is only reachable from Tacit's network (e.g. http://grafana:3000
  # inside Docker). Empty = use `url`.
  # public_url: http://localhost:3000
  org_id: 1
  # api_key: use GRAFANA_API_KEY env var

# ── Slack ────────────────────────────────────────────────────────────────────
# slack:
#   bot_token: use SLACK_BOT_TOKEN env var
#   app_token: use SLACK_APP_TOKEN env var
#   signing_secret: use SLACK_SIGNING_SECRET env var

# ── Context Enrichment (Knowledge Base) ──────────────────────────────────────
context:
  provider: none               # none | mcp | a2a | rag_api
  max_chunks: 10               # max context chunks per query
  # api_key: use CONTEXT_API_KEY env var

  # MCP provider
  mcp_server_url: ""           # e.g. http://mcp-server.internal:8080
  mcp_tool_name: search        # MCP tool name for retrieval

  # A2A provider
  a2a_agent_url: ""            # e.g. http://knowledge-agent.internal:9000

  # RAG API provider
  rag_api_url: ""              # e.g. https://rag.corp.internal/api/v1

# ── Pipeline Tuning ──────────────────────────────────────────────────────────
pipeline:
  max_concurrent: 5            # max simultaneous pipeline runs
  max_concurrent_per_tenant: 0 # wildcard mode: 0 reserves one active slot automatically
  max_queued: 100              # bounded waiters before overload rejection
  max_queued_per_tenant: 25    # wildcard mode: bounded waiters per tenant
  timeout_seconds: 120         # overall pipeline timeout

# ── Datasource Adapters ─────────────────────────────────────────────────────
adapter:
  max_concurrent: 5            # max simultaneous datasource adapter calls
  timeout_seconds: 30          # per-adapter timeout

# ── Metrics ──────────────────────────────────────────────────────────────────
max_metric_catalog_size: 300   # total metrics across all datasources sent to LLM

# ── SQLite Storage ───────────────────────────────────────────────────────────
sqlite:
  snapshot_max_bytes: 1073741824  # per-database cap across main/WAL/retries (1 GiB)
history:
  db_path: data/tacit_history.db
feedback:
  db_path: data/tacit_feedback.db
signals:
  db_path: data/tacit_signals.db

# ── Generated Archetypes (experimental) ─────────────────────────────────────
# These controls are intentionally independent. Generated output is quarantined
# and is never written into the curated system archetype registry.
learned_archetypes:
  generation_enabled: false
  automatic_registration_enabled: false  # legacy name; permits quarantine persistence only
  normal_retrieval_enabled: false
  retrieval_mode: curated_only
  quarantine_path: data/generated_archetypes/quarantine
  generation_version: generated-archetype-v1
  tenant_id: default

# ── HTTP API Auth ────────────────────────────────────────────────────────────
api:
  auth_enabled: false          # set true to require X-API-Key header
  # auth_key: use API_AUTH_KEY env var
  allowed_hosts: "localhost,127.0.0.1,[::1]"  # exact Host-header names; no unrestricted wildcard
  # cors_allowed_origins: https://console.example,https://ops.example
  max_request_body_bytes: 2097152  # 2 MiB; enforced before request parsing
  request_body_max_concurrent: 16  # app-wide authenticated body slots
  request_body_tenant_max_concurrent: 4  # per-tenant body slots
  request_body_max_buffered_bytes: 536870912  # app-wide accounted memory (512 MiB)
  request_body_tenant_max_buffered_bytes: 134217728  # per-tenant accounted memory (128 MiB)
  request_body_memory_amplification_factor: 8  # generic body envelope; structured JSON has a fixed 64x floor
  request_body_memory_floor_bytes: 4194304  # minimum memory charge per request
  request_body_read_timeout_seconds: 15  # total body-read deadline

# ── App ──────────────────────────────────────────────────────────────────────
log_level: INFO
tacit_dashboard_folder: Tacit
tacit_default_timerange: 1h
